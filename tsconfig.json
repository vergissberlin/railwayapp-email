{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"outDir": "dist",
		"rootDir": ".",
		"module": "commonjs",
		"target": "es5",
		"lib": ["es6", "dom"],
		"sourceMap": true,
		"allowJs": true,
		"jsx": "react",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"noUnusedLocals": false
	},
	"exclude": ["node_modules", "build", "scripts", "index.js"]
}
